#!/usr/bin/lua
local json=require 'luci.jsonc'
local fs=require 'nixio.fs'
local pending='/etc/x86-online-pending.json'
local installed='/etc/x86-online-installed.json'
local receipt='/tmp/x86-online-download.json'
local frozen='/tmp/x86-online-verified.bin'
local image='/tmp/x86-online-record-image.tmp'
local function read(p) local f=io.open(p,'rb');if not f then return nil end;local s=f:read('*a');f:close();return s end
local function load(p) local v=json.parse(read(p) or '');return type(v)=='table' and v or {} end
local function write(p,v)
 local f=assert(io.open(p..'.new','w'),'无法写入记录');assert(f:write(json.stringify(v)));f:close()
 assert(fs.chmod(p..'.new','600'));assert(fs.rename(p..'.new',p),'无法保存记录')
end
local function quote(s) return "'"..s:gsub("'","'\"'\"'").."'" end
local function run(c)
 local p=assert(io.popen(c));local s=p:read('*a');p:close();return s
end
local function digest(p,offset,n)
 assert(type(offset)=='number' and offset>=0 and offset%512==0)
 assert(type(n)=='number' and n>0 and n<8589934592)
 local blocks=math.ceil(n/512)
 local skiptext=string.format('%.0f',offset/512)
 local counttext=string.format('%.0f',blocks)
 local bytestext=string.format('%.0f',n)
 local raw=run('set -o pipefail; /bin/dd if='..quote(p)..' bs=512 skip='..skiptext..' count='..counttext..' 2>/dev/null | /usr/bin/head -c '..bytestext..' | /usr/bin/sha256sum; echo DIGEST_EXIT:$?')
 assert(raw:match('DIGEST_EXIT:0%s*$'),'读取文件系统失败')
 local hash=raw:match('^([0-9a-f]+)');assert(hash and #hash==64,'无法计算文件系统 SHA256');return hash
end
local function bootid() return (read('/proc/sys/kernel/random/boot_id') or ''):gsub('%s+$','') end
local function kernel() return run('/bin/uname -r'):gsub('%s+$','') end
local function u32(s,p)
 local a,b,c,d=s:byte(p,p+3);assert(d,'分区数据不完整');return a+b*256+c*65536+d*16777216
end
local function u64(s,p)
 local n=u32(s,p)+u32(s,p+4)*4294967296
 assert(n<9007199254740992,'数值过大');return n
end
local function superblock(f,offset)
 assert(f:seek('set',offset));local s=f:read(96) or ''
 if #s<96 or s:sub(1,4)~='hsqs' then return nil end
 local n=u64(s,41);assert(n>=96 and n<8589934592,'SquashFS 大小异常');return n
end
local function findroot(path)
 local f=assert(io.open(path,'rb'));local size=assert(f:seek('end'));f:seek('set',0)
 local m=assert(f:read(512));assert(#m==512 and m:sub(511,512)=='\085\170','固件缺少有效分区表')
 local entries={}
 f:seek('set',512);local g=f:read(512) or ''
 if g:sub(1,8)=='EFI PART' then
  assert(u32(g,13)>=92,'GPT 头无效')
  local tableoffset=u64(g,73)*512;local count=u32(g,81);local step=u32(g,85)
  assert(count>=1 and count<=256 and step>=128 and step<=512,'GPT 分区表异常')
  assert(tableoffset+count*step<=size,'GPT 分区表超出固件范围')
  for i=0,count-1 do
   f:seek('set',tableoffset+i*step);local e=assert(f:read(step))
   if e:sub(1,16)~=string.rep('\0',16) then
    local first,last=u64(e,33),u64(e,41)
    if first>0 and last>=first then entries[#entries+1]={offset=first*512,limit=(last-first+1)*512} end
   end
  end
 else
  for i=0,3 do
   local p=447+i*16;local first=u32(m,p+8);local length=u32(m,p+12)
   if first>0 and length>0 then entries[#entries+1]={offset=first*512,limit=length*512} end
  end
 end
 local found=nil
 for _,e in ipairs(entries) do
  if e.offset+96<=size then
   local n=superblock(f,e.offset)
   if n then
    assert(n<=e.limit and e.offset+n<=size,'SquashFS 超出分区范围')
    assert(not found,'固件包含多个 SquashFS 分区，停止自动记录')
    found={offset=e.offset,bytes=n}
   end
  end
 end
 f:close();assert(found,'未找到固件的 SquashFS 根文件系统');return found
end
local function rootdevice()
 for line in (read('/proc/self/mountinfo') or ''):gmatch('[^\n]+') do
  local id,parent,dev,root,mount=line:match('^(%d+) (%d+) (%d+:%d+) (%S+) (%S+) ')
  if mount=='/rom' and line:find(' - squashfs ',1,true) then
   local uevent=assert(read('/sys/dev/block/'..dev..'/uevent'),'无法识别 /rom 真实分区')
   local name=uevent:match('DEVNAME=([^\n]+)');assert(name and name:match('^[%w_/%-]+$'),'分区名异常')
   local path='/dev/'..name;local f=assert(io.open(path,'rb'),'无法读取根分区')
   local n=assert(superblock(f,0),'当前根分区不是 SquashFS');f:close();return path,n
  end
 end
 error('未找到 /rom SquashFS 挂载')
end
local function validhash(v) return type(v)=='string' and #v==64 and v:match('^[0-9a-f]+$') end
local function verify()
 local b=bootid();assert(b~='','无法获取启动标识')
 local p=load(pending);local records=load(installed)
 if p.boot_id==b then return {pending=true,message='尚未重启，不确认已安装记录'} end
 local todo={}
 if p.repo and validhash(p.sha256sum) then todo[#todo+1]={pending=true,repo=p.repo,record=p} end
 for repo,r in pairs(records) do
  if type(r)=='table' and r.verified_boot~=b and validhash(r.sha256sum) then todo[#todo+1]={repo=repo,record=r} end
 end
 if #todo==0 then return {ok=true} end
 local path,n=rootdevice();local hash=digest(path,0,n);local k=kernel();local changed=false;local accepted=false
 for _,v in ipairs(todo) do
  local r=v.record
  if r.root_bytes==n and r.root_sha256==hash and r.kernel==k then
   if v.pending or not accepted then
    r.verified_boot=b;r.verified_at=os.time();records[v.repo]=r;changed=true
    if v.pending then accepted=true end
   end
  elseif not v.pending and not (accepted and v.repo==p.repo) then records[v.repo]=nil;changed=true end
 end
 if changed then write(installed,records) end
 if p.repo then
  if accepted then fs.unlink(pending)
  else p.failure='重启后实际根文件系统或内核未匹配，未确认安装';write(pending,p) end
 end
 return {ok=true,installed=accepted,message=accepted and '新固件已验证并记录 SHA256' or '已校验现有记录'}
end
local function prepare()
 assert(not fs.stat('/tmp/x86-online-job.lock'),'下载尚未结束')
 local r=load(receipt)
 assert(r.repo and r.tag and validhash(r.sha256sum) and type(r.size)=='number','缺少下载凭据，请安装本补丁后重新在线下载固件')
 assert(r.kernel and r.kernel:match('^[%w%.%+_%-]+$'),'无法获取目标内核版本')
 local st=assert(fs.stat('/tmp/firmware.bin'),'升级文件不存在')
 assert(st.size==r.size,'升级文件大小已改变，请重新下载')
 assert(fs.rename('/tmp/firmware.bin',frozen),'无法锁定升级文件')
 local sha=run('/usr/bin/sha256sum '..quote(frozen)):match('^([0-9a-f]+)')
 assert(sha==r.sha256sum,'升级文件 SHA256 已改变，禁止更新')
 local free=tonumber(run("df -Pk /tmp | tail -n 1 | awk '{print $4}'")) or 0
 -- Decompression is bounded to 2 GiB and requires spare RAM for the working image.
 assert(free*1024>2214592512,'准备指纹需要 /tmp 至少约 2.1 GiB 可用空间')
 local code=run('set -o pipefail; /bin/gzip -dc '..quote(frozen)..' | /usr/bin/head -c 2147483649 > '..quote(image)..'; echo $?')
 assert(tonumber(code)==0,'解压固件失败或固件超过 2 GiB')
 local image_stat=assert(fs.stat(image));assert(image_stat.size<=2147483648,'解压后固件超过 2 GiB，停止自动记录')
 local root=findroot(image);local rootsha=digest(image,root.offset,root.bytes)
 local b=bootid();assert(b~='','无法读取启动标识')
 write(pending,{repo=r.repo,tag=r.tag,sha256sum=r.sha256sum,size=r.size,root_sha256=rootsha,root_bytes=root.bytes,kernel=r.kernel,boot_id=b,created=os.time()})
 fs.unlink(image)
 assert(fs.rename(frozen,'/tmp/firmware.bin'),'无法交接到原生升级文件路径')
 return {ready=true}
end
local ok,value=pcall(function()
 if arg[1]=='prepare' then return prepare() end
 if arg[1]=='verify' then
  if not fs.mkdir('/tmp/x86-online-record-verify.lock') then return {busy=true} end
  local good,result=pcall(verify)
  fs.rmdir('/tmp/x86-online-record-verify.lock')
  assert(good,result);return result
 end
 error('未知记录操作')
end)
if not ok then
 fs.unlink(image)
 if arg[1]=='prepare' and not fs.stat('/tmp/firmware.bin') and fs.stat(frozen) then fs.rename(frozen,'/tmp/firmware.bin') end
 value={error=tostring(value)}
end
io.write(json.stringify(value))
