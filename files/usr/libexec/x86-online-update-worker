#!/usr/bin/lua
local json = require 'luci.jsonc'
local fs = require 'nixio.fs'
local function emit(v) io.write(json.stringify(v)) end
if arg[1] == 'list' then io.write('{"check":{},"download":{}}'); return end
if arg[1] ~= 'call' then return end
local function quote(s) return "'" .. s:gsub("'", "'\"'\"'") .. "'" end
local function run(cmd)
 local p=io.popen(cmd); if not p then error('无法执行命令') end
 local s=p:read('*a'); p:close(); return s
end
local config_path='/etc/x86-online-update.json'
local default_repo='longdongqiang-jason/X86-daed'
local function valid_repo(s)
 return type(s)=='string' and #s<=180 and s:match('^[%w_%-]+/[%w_%.%-]+$') and not s:find('..',1,true)
end
local function config()
 local f=io.open(config_path);local v=nil
 if f then v=json.parse(f:read('*a'));f:close() end
 v=type(v)=='table' and v or {}
 local custom=valid_repo(v.custom_repo) and v.custom_repo or ''
 local source=v.source=='custom' and 'custom' or 'default'
 if source=='custom' and custom=='' then source='default' end
 return {source=source,custom_repo=custom,repo=source=='custom' and custom or default_repo}
end
local selected=config()
local base='https://api.github.com/repos/'..selected.repo..'/releases/latest'
local function latest()
 local raw=run('/usr/bin/curl -fLsS --connect-timeout 15 --max-time 40 --max-filesize 2097152 '..quote(base)..' 2>/dev/null')
 local r=json.parse(raw)
 if not r or not r.assets or r.draft or r.prerelease then error('读取 GitHub 最新发布失败') end
 for _,a in ipairs(r.assets) do
  if a.name and a.name:match('^[%w%.%-]+%-openwrt%-x86%-64%-generic%-squashfs%-combined%-efi%.img%.gz$') then
   local hash=(a.digest or ''):match('^sha256:([0-9a-f]+)$')
   if not hash or #hash~=64 then error('发布文件缺少 SHA256，停止下载') end
   if not a.size or a.size<1 or a.size>2147483648 then error('发布文件大小异常') end
   local prefix='https://github.com/'..selected.repo..'/releases/download/'
   local url=a.browser_download_url or ''
   if url:sub(1,#prefix)~=prefix or not url:sub(#prefix+1):match('^[%w%.%-%_/]+%.img%.gz$') then error('固件地址异常') end
   local verification=json.parse(run('/usr/libexec/x86-online-record verify 2>/tmp/x86-online-record-verify-error.log')) or {}
   local records=json.parse(fs.readfile('/etc/x86-online-installed.json') or '') or {}
   local record=records[selected.repo]
   local boot=(fs.readfile('/proc/sys/kernel/random/boot_id') or ''):gsub('%s+$','')
   if type(record)~='table' or record.verified_boot~=boot then record=nil end
   local state=record and (record.sha256sum==hash and 'matched' or 'different') or 'unknown'
   if not record and verification.busy then state='verifying' end
   return {tag=r.tag_name,name=a.name,size=a.size,sha256sum=hash,url=a.browser_download_url,
    comparison=state,installed_sha256=record and record.sha256sum or '',installed_tag=record and record.tag or '',
    latest_kernel=a.name:match('%-daed%-(.-)%-openwrt%-') or ''}
  end
 end
 error('最新发布没有匹配的 x86-64 squashfs EFI 固件')
end
local locked=false
local ok,res=pcall(function()
 if arg[2]~='check' and arg[2]~='download' then error('未知操作') end
 local board=json.parse(run('/bin/ubus call system board')) or {}
 if board.board_name~='x86_64' and not (board.release and board.release.target=='x86/64') then error('仅支持 x86/64 设备') end
 if not fs.stat('/sys/firmware/efi') then error('当前设备未以 EFI 启动，停止操作') end
 if arg[2]=='check' then return latest() end
 if not fs.mkdir('/tmp/x86-online-update.lock') then error('已有在线下载任务；如任务意外中断请检查锁目录') end
 locked=true
 local info=latest()
 local meta=io.open('/tmp/x86-online-job.meta','w')
 if meta then meta:write(json.stringify({size=info.size}));meta:close() end
 local path='/tmp/x86-online-firmware.part'
 local free=tonumber(run("df -Pk /tmp | tail -n 1 | awk '{print $4}'")) or 0
 if free*1024<info.size+67108864 then error('/tmp 可用空间不足') end
 local code=run('/usr/bin/curl -fLsS --proto =https --proto-redir =https --connect-timeout 20 --max-time 540 --max-filesize '..info.size..' -o '..path..' '..quote(info.url)..' >/dev/null 2>&1; echo $?')
 if tonumber(code)~=0 then fs.unlink(path); error('下载失败或超时，请重试') end
 local st=fs.stat(path)
 if not st or st.size~=info.size then fs.unlink(path); error('文件字节数不一致，禁止更新') end
 local hash=run('/usr/bin/sha256sum '..path):match('^([0-9a-f]+)')
 if hash~=info.sha256sum then fs.unlink(path); error('SHA256 不一致，禁止更新') end
 if not fs.rename(path,'/tmp/firmware.bin') then error('无法准备升级文件') end
 local receipt={repo=selected.repo,tag=info.tag,sha256sum=hash,size=info.size,kernel=info.latest_kernel}
 local f=assert(io.open('/tmp/x86-online-download.json.new','w'),'无法保存下载凭据')
 assert(f:write(json.stringify(receipt)));f:close()
 assert(fs.chmod('/tmp/x86-online-download.json.new','600'))
 assert(fs.rename('/tmp/x86-online-download.json.new','/tmp/x86-online-download.json'))
 return {size=info.size,sha256sum=hash}
end)
if locked then fs.rmdir('/tmp/x86-online-update.lock') end
emit(ok and res or {error=tostring(res)})
